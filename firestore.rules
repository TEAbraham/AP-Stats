rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🛡 Utility functions
    function isAdmin() {
      return request.auth.token.admin == true
        && request.auth.token.email == "thomas.e.abraham@gmail.com";
    }

    // Allow admins to read/write everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    function signedIn() {
      return request.auth != null;
    }

    // Own doc, or a doc that doesn't exist yet (pages getDoc() before first write)
    function canGetOwn() {
      return signedIn() &&
             (resource == null || resource.data.userId == request.auth.uid);
    }

    // Queries must be filtered with where("userId", "==", uid)
    function canListOwn() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    // New doc must belong to the caller and use a "<uid>_..." id
    function canCreateOwn(docId) {
      return signedIn() &&
             request.resource.data.userId == request.auth.uid &&
             docId.matches(request.auth.uid + '_.*');
    }

    // Users can read only their own profile
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
    }

    // Allow logged-in users to read questions (excluding correct answers)
    match /mcq_questions/{questionId} {
      allow get, list: if request.auth != null;
    }

    // Allow logged-in users to read questions (excluding correct answers)
    match /frq_questions/{questionId} {
      allow get, list: if request.auth != null;
    }

    // Students read their own answers and record each answer once
    match /student_answers/{docId} {
      allow get: if canGetOwn();
      allow list: if canListOwn();
      allow create: if canCreateOwn(docId);
    }

    match /unit_completion/{docId} {
      allow get: if canGetOwn();
      allow list: if canListOwn();
      allow create: if canCreateOwn(docId);
    }

    // Written only by the admin backfill script; doc id is the student's uid
    match /student_summary/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }
  }
}